node_modules

# Environment variables — every variant, because the risk of committing one is
# not worth the tidiness of an exact list. .env.example is the exception: it
# is documentation and carries no real values.
.env*
!.env.example

# The CMS development database's connection string (Task 3, CMS foundation).
# Already covered by .env* above; named explicitly because it holds a real
# Postgres URL and must never end up in a commit.
.env.cms-dev

/generated/prisma

# Local SQLite leftovers from before the move to Postgres
*.db

# Hero-loop working media: candidates, raw clips and loop intermediates are not deliverables.
# Only the final loop + poster get committed, explicitly, from the hero-loop branch.
media/hero/candidates/
media/hero/lava/
media/hero/video/
media/hero/lava2/
