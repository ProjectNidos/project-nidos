# Public site address (metadata, sitemap, own-referrer check)
SITE_URL=https://projectnidos.eu

# Supabase project. Server-side only: nothing here reaches the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Secret for the daily visitor code in analytics. Generate: openssl rand -hex 32
ANALYTICS_SALT=

# Preview deploys only: 1 sends "noindex" so search engines skip the preview address.
# NOINDEX=1
